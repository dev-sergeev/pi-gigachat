{
	"name": "@dev-sergeev/pi-gigachat",
	"version": "0.2.0",
	"description": "GigaChat provider extension for pi-coding-agent",
	"private": false,
	"type": "module",
	"license": "MIT",
	"author": "ai-forever",
	"keywords": [
		"pi-package",
		"gigachat",
		"pi-coding-agent",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dev-sergeev/pi-gigachat.git"
	},
	"homepage": "https://github.com/dev-sergeev/pi-gigachat#readme",
	"bugs": {
		"url": "https://github.com/dev-sergeev/pi-gigachat/issues"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"extension.js",
		"THIRD_PARTY_NOTICES",
		".env.example",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build.mjs",
		"clean": "rm -rf dist",
		"check": "biome check --error-on-warnings src package.json README.md && tsc --noEmit",
		"test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
		"prepublishOnly": "npm run build && npm run check",
		"prepack": "npm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./extension.js"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1"
	},
	"dependencies": {
		"eventsource-parser": "^3.0.6",
		"undici": "^8.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.5",
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@types/node": "^24.3.0",
		"esbuild": "0.28.1",
		"typescript": "^5.9.2"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	}
}
