{
	"name": "@dev-sergeev/pi-gigachat",
	"version": "0.2.0",
	"description": "GigaChat provider extension for pi-coding-agent",
	"private": false,
	"type": "module",
	"license": "MIT",
	"author": "dev-sergeev",
	"keywords": [
		"pi-package",
		"gigachat",
		"pi-coding-agent",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dev-sergeev/pi-gigachat.git"
	},
	"homepage": "https://github.com/dev-sergeev/pi-gigachat#readme",
	"bugs": {
		"url": "https://github.com/dev-sergeev/pi-gigachat/issues"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings src test package.json tsconfig.json tsconfig.build.json",
		"test": "vitest run",
		"check": "npm run lint && npm run typecheck && npm test",
		"format": "biome check --write src test package.json tsconfig.json tsconfig.build.json README.md .github",
		"prepack": "npm run build",
		"prepublishOnly": "npm run check"
	},
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"dependencies": {
		"gigachat": "^0.0.20"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.5",
		"@earendil-works/pi-ai": "^0.83.0",
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@types/node": "^24.12.4",
		"typescript": "^5.9.3",
		"vitest": "^4.1.9"
	}
}
