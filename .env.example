# This file is not loaded automatically. Use the README launch command.
# Current OAuth access token, without the "Bearer " prefix.
GIGACHAT_ACCESS_TOKEN=
GIGACHAT_BASE_URL=https://api.giga.chat/v1

# true = incremental SSE; false = complete JSON response.
GIGACHAT_STREAM=false
# Top-level request overrides, also applied to tool follow-ups and summaries.
# Quote JSON so this file can be sourced by Bash/Zsh.
GIGACHAT_EXTRA_BODY='{}'
# Example: GIGACHAT_EXTRA_BODY='{"temperature":0.2,"max_tokens":4096}'

# Provider instructions appended to pi's system prompt, including summaries.
# Supports multiple lines inside single quotes; empty means no extra prompt.
GIGACHAT_SYSTEM_PROMPT=''

# Automatic renewal: leave ACCESS_TOKEN empty and supply an authorization key.
# Stored /login credentials take priority; /logout gigachat switches to env auth.
# GIGACHAT_CREDENTIALS=your_base64_authorization_key
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_TIMEOUT=300

# Load trusted CAs before Node starts if required by the API or your proxy.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/trusted-ca-bundle.pem
# HTTPS_PROXY=http://127.0.0.1:8080
# HTTP_PROXY=http://127.0.0.1:8080
# NO_PROXY=127.0.0.1,localhost
